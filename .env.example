# Almanac environment variables
#
# NASA APOD API key. DEMO_KEY works but is heavily rate-limited.
# Get a free personal key (email only) at https://api.nasa.gov
#
# Vite only exposes variables prefixed with VITE_ to the client.
# For the container build this is passed as a build arg (see compose.yaml).
VITE_NASA_API_KEY=DEMO_KEY
